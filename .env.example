# Optional operator-only Fireworks credentials. Users supply their own per request.
# Get your API key from: https://fireworks.ai/
FIREWORKS_API_KEY=

# Exact tool-capable model identifier. Both key and model are required.
# Examples:
#   FIREWORKS_MODEL=accounts/YOUR_ACCOUNT/deployments/YOUR_DEPLOYMENT
#   FIREWORKS_MODEL=accounts/fireworks/models/YOUR_SERVERLESS_MODEL
FIREWORKS_MODEL=

# Operator key (REQUIRED for production). Never distribute it to users.
# Generate a secure random key: openssl rand -hex 32
# Users create separate workspace keys in the dashboard.
CRASHLENS_API_KEY=

# Backend Port (default: 8080)
PORT=8080

# Frontend API URL
# For local development: http://localhost:8080
# For Docker: use a URL reachable from your browser (not http://backend:8080).
# This value is embedded at build time; rebuild the frontend after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional local database path; Docker Compose uses its persistent volume.
# DATABASE_PATH=./crashlens.db

# Private access is recommended. Demo anonymous reads stop once user keys exist.
# Authenticated requests are always scoped to the connected owner.
ACCESS_MODE=private
# Set APP_ENV=production to require a configured API key on any host.
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Explicit trusted proxy networks only. Leave empty to ignore forwarded IP headers.
TRUSTED_PROXY_CIDRS=
JOB_CONCURRENCY=2
JOB_QUEUE_SIZE=16
JOB_TIMEOUT_SECONDS=300
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Public self-service workspace creation; set false for operator-only issuance.
ALLOW_WORKSPACE_CREATION=true
