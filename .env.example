# Fireworks AI API Key (optional - system falls back to the rule-based diagnosis)
# Get your API key from: https://fireworks.ai/
FIREWORKS_API_KEY=

# Fireworks Model/Deployment (optional - uses default deployment if not set)
# Examples:
#   FIREWORKS_MODEL=accounts/YOUR_ACCOUNT/deployments/YOUR_DEPLOYMENT
#   FIREWORKS_MODEL=accounts/fireworks/models/gemma-2-9b-it
FIREWORKS_MODEL=

# CrashLens API Key (REQUIRED for production - protects write/delete operations)
# Generate a secure random key: openssl rand -hex 32
# If not set, all routes are unprotected (development mode only!)
CRASHLENS_API_KEY=

# Backend Port (default: 8080)
PORT=8080

# Frontend API URL
# For local development: http://localhost:8080
# For Docker: use a URL reachable from your browser (not http://backend:8080).
# This value is embedded at build time; rebuild the frontend after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional local database path; Docker Compose uses its persistent volume.
# DATABASE_PATH=./crashlens.db
